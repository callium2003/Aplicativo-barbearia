{
  "name": "barbeariasp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "package:hostinger": "node scripts/build-hostinger.mjs && node scripts/prepare-hostinger-standalone.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:build": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "notifications:process": "node scripts/process-notifications.mjs",
    "health:check": "node --use-system-ca scripts/check-health.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "deps:scripts:pending": "npm approve-scripts --allow-scripts-pending"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "supabase": "2.111.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
